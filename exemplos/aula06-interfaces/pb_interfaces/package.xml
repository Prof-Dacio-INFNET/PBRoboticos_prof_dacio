<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pb_interfaces</name>
  <version>0.1.0</version>
  <description>Interfaces proprias da disciplina PB Sistemas Roboticos: mensagens e servicos de percepcao.</description>
  <maintainer email="dacioms@gmail.com">Dacio Moreira de Souza</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ESTAS TRES LINHAS SAO O QUE FAZ O PACOTE GERAR CODIGO -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Deteccoes.msg usa std_msgs/Header: a dependencia precisa estar aqui -->
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
