# RViz2 da Aula 13: a imagem segmentada do /vision/segmented, como o item 3 do
# enunciado do TP3 pede.
#
# O detalhe que custa uma tarde a quem nao sabe esta em "Reliability Policy:
# Best Effort", abaixo. O no publica a imagem como dado de sensor
# (BEST_EFFORT); um display que pede RELIABLE simplesmente NAO recebe nada, e
# nao aparece erro nenhum -- so um painel vazio. QoS incompativel nao da erro,
# da silencio, e e o defeito mais procurado em vao do TP3.
#
# Nao ha display 3D nenhum aqui de proposito: este arquivo e para OLHAR A
# IMAGEM. O Fixed Frame continua sendo `camera` porque e o frame_id que o no
# escreve no header, e o RViz2 reclama se o Fixed Frame nao existir na arvore.
# Por isso o launch sobe um static_transform_publisher world->camera junto com
# o RViz2: a imagem apareceria sem ele, mas o painel ficaria amarelo -- e aviso
# amarelo que nao significa nada e caro numa disciplina que ensina a olhar aviso.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Imagem segmentada1
      Splitter Ratio: 0.5
    Tree Height: 400
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Image
      Name: Imagem segmentada
      Enabled: true
      Topic:
        Value: /vision/segmented
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Max Value: 1
      Min Value: 0
      Median window: 5
      Normalize Range: true
      Value: true

    # O frame cru, para comparar com a sobreposicao ao lado. Desligado por
    # padrao: ligue quando quiser conferir se a camada mexeu so onde havia
    # mascara -- fora dela o pixel e o mesmo, byte a byte.
    - Class: rviz_default_plugins/Image
      Name: Frame cru (/camera/image_raw)
      Enabled: false
      Topic:
        Value: /camera/image_raw
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Max Value: 1
      Min Value: 0
      Median window: 5
      Normalize Range: true
      Value: true

  Global Options:
    Fixed Frame: camera
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 4
      Near Clip Distance: 0.01
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
  Displays:
    collapsed: false
  Imagem segmentada:
    collapsed: false
