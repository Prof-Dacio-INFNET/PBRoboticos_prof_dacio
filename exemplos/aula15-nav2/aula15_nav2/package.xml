<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aula15_nav2</name>
  <version>0.1.0</version>
  <description>O Nav2 sobre o mundo minimo: mapa conhecido, AMCL, NavFn e DWB -- Aula 15, Etapa 8.</description>
  <maintainer email="dacioms@gmail.com">Dacio Moreira de Souza</maintainer>
  <license>MIT</license>

  <!-- O mundo, o /scan, o /odom e a TF odom->base_footprint vem da Aula 11. -->
  <exec_depend>aula11_mundo</exec_depend>

  <!-- O Nav2. Pelo apt: sudo apt install ros-humble-navigation2 ros-humble-nav2-bringup
       O metapacote navigation2 traz os servidores E o nav2_rviz_plugins (de
       onde vem o display da nuvem de particulas); o nav2_bringup traz os
       launches e os YAMLs de referencia, e depende de navigation2. -->
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>

  <!-- O no `rota`: cliente da acao navigate_to_pose. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
